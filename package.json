{
  "name": "@react-native-ohos/react-native-location",
  "version": "1.0.0-beta.1",
  "description": "Native GPS location support for React Native",
  "author": "React Native Community",
  "main": "./dist/commonjs/index.js",
  "module": "./dist/module/index.js",
  "react-native": "./dist/module/index.js",
  "types": "./dist/typescript/index.d.ts",
  "license": "MIT",
  "private": false,
  "repository": {
    "type": "git",
    "url": "https://github.com/cbd1020819393/react-native-location.git"
  },
  "bugs": {
    "url": "https://github.com/cbd1020819393/react-native-location/issues"
  },
  "keywords": [
    "react-native",
    "react-component",
    "ios",
    "android",
    "harmony",
    "harmonyos",
    "location"
  ],
  "homepage": "https://github.com/cbd1020819393/react-native-location",
  "publishConfig": {
    "registry": "https://registry.npmjs.org/"
  },
  "files": [
    "dist/",
    "src/",
    "harmony/",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "prepare": "tsc --noEmit && bob build",
    "codegen-lib": "react-native codegen-harmony --cpp-output-path ./harmony/location/src/main/cpp/generated --ets-output-path ./harmony/location/src/main/ets/generated"
  },
  "peerDependencies": {
    "react-native": ">=0.72"
  },
  "devDependencies": {
    "@react-native-oh/react-native-harmony-cli": "^0.77.50",
    "@react-native/typescript-config": "0.79.5",
    "@types/react": "18.2.79",
    "jest": "^29.6.3",
    "metro": "^0.81.0",
    "react": "18.2.0",
    "react-native": "0.72.5",
    "react-native-builder-bob": "^0.18.0",
    "typescript": "5.0.4"
  },
  "engines": {
    "node": ">=18"
  },
  "harmony": {
    "alias": "react-native-location",
    "autolinking": {
      "cmakeLibraryTargetName": "location",
      "ohPackageName": "@react-native-ohos/react-native-location",
      "etsPackageClassName": "LocationPackage",
      "cppPackageClassName": "LocationPackage"
    },
    "codegenConfig": [
      {
        "version": 1,
        "specPaths": [
          "./src/specs/v1"
        ]
      }
    ]
  },
  "react-native-builder-bob": {
    "source": "src",
    "output": "dist",
    "targets": [
      "commonjs",
      "module",
      "typescript"
    ]
  },
  "dependencies": {
    "react-native-location": "^2.5.0"
  }
}
