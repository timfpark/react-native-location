{
  "name": "react-native-location-example",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "start": "hdc rport tcp:8081 tcp:8081 && react-native start",
    "fast-install-project": "cd ../ && npm i --legacy-peer-deps && npm pack && cd ./example && npm i --legacy-peer-deps",
    "fast:pkg": "npm run fast-install-project && npm run dev",
    "pack:pkg": "cd ../ && npm i -f && npm pack && cd ./example",
    "install:pkg": "npm uninstall @react-native-ohos/react-native-location && npm run pack:pkg && npm i @react-native-ohos/react-native-location@file:../react-native-ohos-react-native-location-1.0.0-beta.1.tgz",
    "postinstall": "node ./scripts/create-build-profile",
    "codegen": "react-native codegen-harmony --cpp-output-path ./harmony/entry/src/main/cpp/generated --ets-output-path ./harmony/entry/src/main/ets/generated",
    "bundle:dev": "react-native bundle-harmony --dev --minify=false",
    "bundle:prod": "react-native bundle-harmony --dev=false --minify=true",
    "dev": "npm run codegen && react-native bundle-harmony --dev --minify=false",
    "prod": "npm run codegen && react-native bundle-harmony --dev=false --minify=true",
    "lint": "eslint .",
    "test": "jest",
    "tsc": "tsc --noEmit"
  },
  "dependencies": {
    "@react-native-oh/react-native-harmony": "0.72.139",
    "@react-native-ohos/react-native-location": "file:../react-native-ohos-react-native-location-1.0.0-beta.1.tgz",
    "react": "18.2.0",
    "react-native": "0.72.5"
  },
  "devDependencies": {
    "@babel/core": "^7.20.0",
    "@babel/preset-env": "^7.20.0",
    "@babel/runtime": "^7.20.0",
    "@react-native/eslint-config": "^0.72.2",
    "@react-native/metro-config": "^0.72.11",
    "@react-native-oh/react-native-harmony-cli": "0.72.139",
    "@tsconfig/react-native": "^3.0.0",
    "@types/react": "^18.0.24",
    "@types/react-test-renderer": "^18.0.0",
    "babel-jest": "^29.2.1",
    "eslint": "^8.19.0",
    "jest": "^29.2.1",
    "json5": "^2.2.3",
    "metro-react-native-babel-preset": "0.76.8",
    "prettier": "^2.4.1",
    "react-test-renderer": "18.2.0",
    "typescript": "^5.0.0"
  },
  "overrides": {
    "@react-native-community/cli": "11.3.6",
    "@react-native/codegen": "0.74.0"
  },
  "resolutions": {
    "@react-native-community/cli": "11.3.6"
  },
  "engines": {
    "node": ">=20"
  }
}
